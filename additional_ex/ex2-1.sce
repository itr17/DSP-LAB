clc;
clear;

// =====================================================
// (a) Vẽ tín hiệu x(n)
// =====================================================

n = -3:3;
x = [0 1/3 2/3 1 1 1 1];

scf(1);
clf();

plot2d3(n, x);

xlabel("n");
ylabel("x(n)");
title("Tín hiệu x(n)");
xgrid();

xs2png(1, "x_n.png");


// =====================================================
// (b.1) Fold x(n) rồi delay 4 mẫu
//
// x(n) -> x(-n) -> x(-(n-4))
//                  = x(-n+4)
// =====================================================

n1 = 1:6;
y1 = [1 1 1 1 2/3 1/3];

scf(2);
clf();

plot2d3(n1, y1);

xlabel("n");
ylabel("y_1(n)");
title("Fold x(n), then delay 4 samples");
xgrid();

xs2png(2, "fold_then_delay.png");


// =====================================================
// (b.2) Delay x(n) 4 mẫu rồi fold
//
// x(n) -> x(n-4) -> x(-n-4)
// =====================================================

n2 = -7:-2;
y2 = [1 1 1 1 2/3 1/3];

scf(3);
clf();

plot2d3(n2, y2);

xlabel("n");
ylabel("y_2(n)");
title("Delay x(n) 4 samples, then fold");
xgrid();

xs2png(3, "delay_then_fold.png");


// =====================================================
// (b) So sánh hai trường hợp
// =====================================================

scf(4);
clf();

subplot(2,1,1);

plot2d3(n1, y1);

xlabel("n");
ylabel("y_1(n)");
title("Fold then delay: y_1(n) = x(-n+4)");
xgrid();


subplot(2,1,2);

plot2d3(n2, y2);

xlabel("n");
ylabel("y_2(n)");
title("Delay then fold: y_2(n) = x(-n-4)");
xgrid();

xs2png(4, "part_b.png");


// =====================================================
// (e) Tín hiệu đơn vị u(n) và xung đơn vị delta(n)
// =====================================================

n4 = -5:5;


// -----------------------------------------------------
// Tín hiệu đơn vị u(n)
// u(n) = 0, n < 0
//        1, n >= 0
// -----------------------------------------------------

u = zeros(1, length(n4));

for i = 1:length(n4)
    if n4(i) >= 0 then
        u(i) = 1;
    end
end


// -----------------------------------------------------
// Tín hiệu xung đơn vị delta(n)
// delta(n) = 1, n = 0
//            0, n != 0
// -----------------------------------------------------

delta = zeros(1, length(n4));

for i = 1:length(n4)
    if n4(i) == 0 then
        delta(i) = 1;
    end
end


// =====================================================
// Figure 5: Tín hiệu đơn vị u(n) và xung đơn vị
// =====================================================

scf(5);
clf();


// -----------------------------------------------------
// u(n)
// -----------------------------------------------------

subplot(2,1,1);

plot2d3(n4, u);

xlabel("n");
ylabel("u(n)");
title("Tín hiệu đơn vị u(n)");
xgrid();


// -----------------------------------------------------
// delta(n)
// -----------------------------------------------------

subplot(2,1,2);

plot2d3(n4, delta);

xlabel("n");
ylabel("delta(n)");
title("Tín hiệu xung đơn vị delta(n)");
xgrid();


// Lưu hình
xs2png(5, "unit_step_and_impulse.png");
